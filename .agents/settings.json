{
  "permissions": {
    "allow": [
      "Bash(sc:*)",
      "Bash(bin/sc:*)",
      "Bash(claude agents:*)",
      "Bash(claude logs:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/bin/sc hook chef-start",
            "timeout": 60
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/bin/sc hook guard-edit",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/bin/sc hook chef-stop",
            "timeout": 30
          }
        ]
      }
    ]
  },
  "worktree": {
    "bgIsolation": "none"
  },
  "autoCompactEnabled": true,
  "autoCompactWindow": 500000
}
